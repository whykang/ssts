<UserControl x:Class="tingshu.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:tingshu.Controls"
             xmlns:vm="clr-namespace:tingshu.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" c:Ui.LoadMoreCommand="{Binding LoadMoreCommand}">
        <StackPanel Margin="32,4,32,32">
            <TextBlock Text="聚合搜索" Style="{StaticResource T.Display}" Margin="0,0,0,18"/>

            <!-- 搜索框 -->
            <Grid MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Box" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" MinHeight="46" FontSize="15"
                         c:Ui.Icon="&#xE721;" c:Ui.Placeholder="输入书名、作者或演播，同时搜索所有已启用的源" c:Ui.CornerRadius="12" MinWidth="320">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Style="{StaticResource Btn.Primary}" Content="搜索" MinHeight="46" Padding="26,0" Margin="10,0,0,0"
                        c:Ui.CornerRadius="12" Command="{Binding SearchCommand}"/>
            </Grid>

            <!-- 搜索历史 -->
            <StackPanel Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisInv}}">
                <DockPanel Margin="0,4,0,10" Visibility="{Binding History.Count, Converter={StaticResource EmptyToCollapsed}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="清空" MinHeight="28" Padding="10,2"
                            Foreground="{DynamicResource B.Text3}" Command="{Binding ClearHistoryCommand}"/>
                    <TextBlock Text="搜索历史" Style="{StaticResource T.Subtitle}" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Btn.Outline}" Content="{Binding}" Margin="0,0,8,8" MinHeight="30" Padding="14,3"
                                    c:Ui.CornerRadius="15"
                                    Command="{Binding DataContext.SearchHistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Visibility="{Binding HasSearched, Converter={StaticResource BoolToVis}}">
                <!-- 各源进度 -->
                <ItemsControl ItemsSource="{Binding SourceStates}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SourceSearchState}">
                            <Border x:Name="b" Style="{StaticResource Badge}" Margin="0,0,6,6" Padding="8,3" ToolTip="{Binding Error}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="dot" Width="6" Height="6" Fill="{DynamicResource B.Text3}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" Margin="6,0,0,0" Foreground="{DynamicResource B.Text2}"/>
                                    <TextBlock x:Name="count" Text="{Binding Count}" FontSize="11.5" Margin="5,0,0,0" Foreground="{DynamicResource B.Text3}"/>
                                    <Button Style="{StaticResource Btn.Ghost}" Content="验证" MinHeight="0" Padding="6,0" Margin="4,0,0,0" FontSize="11.5"
                                            Foreground="{DynamicResource B.Accent}" ToolTip="这个网站搜索需要人机验证，点击打开验证页面，完成后自动重新搜索"
                                            Visibility="{Binding NeedsVerification, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.VerifyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Loading">
                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource B.Accent}"/>
                                    <Setter TargetName="count" Property="Text" Value="…"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Waiting">
                                    <Setter TargetName="count" Property="Text" Value=""/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Done">
                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource B.Success}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="NeedsVerification">
                                    <Setter TargetName="dot" Property="Fill" Value="#F59E0B"/>
                                    <Setter TargetName="count" Property="Text" Value="需验证"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Failed">
                                    <Setter TargetName="dot" Property="Fill" Value="{DynamicResource B.Danger}"/>
                                    <Setter TargetName="count" Property="Text" Value="失败"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <c:Spinner Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource T.Secondary}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 按源筛选 -->
                <ListBox Style="{StaticResource Plain.ListBox}" ItemContainerStyle="{StaticResource Chip}" ItemsSource="{Binding Filters}"
                         SelectedIndex="{Binding SelectedFilterIndex}" Margin="0,0,0,8"
                         Visibility="{Binding Results.Count, Converter={StaticResource EmptyToCollapsed}}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name, FallbackValue=全部, TargetNullValue=全部}"/>
                                <TextBlock Text="{Binding Count}" Margin="6,0,0,0" Opacity="0.7"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ItemsControl ItemsSource="{Binding Results}" ItemTemplate="{StaticResource BookCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:ResponsiveGrid MinItemWidth="330" Spacing="14"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <c:Spinner Margin="0,20" Visibility="{Binding IsLoadingMore, Converter={StaticResource BoolToVis}}"/>
                <Button Style="{StaticResource Btn.Secondary}" Content="加载更多" HorizontalAlignment="Center" Margin="0,20,0,0"
                        Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Style="{StaticResource EmptyState}">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{StaticResource MultiEquals}">
                            <Binding Path="Results.Count"/>
                            <Binding Source="{StaticResource Zero}"/>
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource F.Icons}" FontSize="44" Foreground="{DynamicResource B.Text3}" HorizontalAlignment="Center"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisInv}}"/>
                    <TextBlock Text="没有找到相关结果，换个关键词试试" Style="{StaticResource T.Secondary}" Margin="0,14,0,0"
                               Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisInv}}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
