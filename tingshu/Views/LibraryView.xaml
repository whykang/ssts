<UserControl x:Class="tingshu.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:tingshu.Controls"
             xmlns:vm="clr-namespace:tingshu.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,4,32,32">
            <!-- 标题 -->
            <DockPanel Margin="0,0,0,20">
                <Border DockPanel.Dock="Right" Background="{DynamicResource B.SurfaceAlt}" CornerRadius="9" Padding="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" Content="书架" GroupName="libtab"
                                     IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=favorites}"/>
                        <RadioButton Style="{StaticResource Segment}" Content="最近播放" GroupName="libtab"
                                     IsChecked="{Binding Tab, Converter={StaticResource Equals}, ConverterParameter=recent}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="我的书架" Style="{StaticResource T.Display}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- 继续收听 -->
            <Border CornerRadius="16" Padding="20" Margin="0,0,0,28" ClipToBounds="True"
                    Visibility="{Binding Player.HasBook, Converter={StaticResource BoolToVis}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{DynamicResource C.Accent}" Offset="0"/>
                        <GradientStop Color="#FF9A6B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="10" Effect="{StaticResource E.Shadow}">
                        <c:CoverImage Width="84" Height="112" Radius="10" Url="{Binding Player.Book.CoverUrl}" SourceId="{Binding Player.Book.SourceId}"
                                      Title="{Binding Player.Book.Title}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock Text="继续收听" Foreground="#E6FFFFFF" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Player.Book.Title}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Player.EpisodeTitle}" Foreground="#E6FFFFFF" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,12,0,0" MaxWidth="420" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Background="#40FFFFFF" Foreground="White" Maximum="{Binding Player.Duration}" Value="{Binding Player.Position, Mode=OneWay}"
                                         VerticalAlignment="Center" MinWidth="160"/>
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Foreground="#E6FFFFFF" FontSize="11.5">
                                <Run Text="{Binding Player.PositionText, Mode=OneWay}"/> / <Run Text="{Binding Player.DurationText, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="2" Width="56" Height="56" Style="{StaticResource Btn.Base}" Background="White" Foreground="{DynamicResource B.Accent}"
                            c:Ui.CornerRadius="28" FontFamily="{StaticResource F.Icons}" FontSize="22" Padding="0" VerticalAlignment="Center"
                            Content="{Binding Player.IsPlaying, Converter={StaticResource PlayGlyph}}"
                            Command="{Binding Player.TogglePlayCommand}" ToolTip="播放 / 暂停"/>
                </Grid>
            </Border>

            <!-- 列表 -->
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource RecordCard}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <c:ResponsiveGrid MinItemWidth="150" Spacing="22" MaxColumns="10"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel Style="{StaticResource EmptyState}" Visibility="{Binding Items.Count, Converter={StaticResource EmptyToVisible}}">
                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource F.Icons}" FontSize="48" Foreground="{DynamicResource B.Text3}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding EmptyText}" Style="{StaticResource T.Secondary}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Style="{StaticResource Btn.Primary}" Content="去发现" Margin="0,0,10,0" Click="GoDiscover"/>
                    <Button Style="{StaticResource Btn.Secondary}" Content="搜索" Click="GoSearch"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
