<UserControl x:Class="tingshu.Views.BookDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:tingshu.Controls"
             xmlns:sdk="clr-namespace:TingShu.Sdk;assembly=TingShu.Sdk">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 模糊封面背景 -->
        <Grid Grid.RowSpan="2" VerticalAlignment="Top" Height="330" ClipToBounds="True" IsHitTestVisible="False">
            <c:CoverImage Url="{Binding Record.CoverUrl}" SourceId="{Binding Record.SourceId}" Title="{Binding Record.Title}" Radius="0"
                          Opacity="0.55" Margin="-60" RenderTransformOrigin="0.5,0.5">
                <c:CoverImage.Effect>
                    <BlurEffect Radius="80" KernelType="Gaussian" RenderingBias="Performance"/>
                </c:CoverImage.Effect>
            </c:CoverImage>
            <Border Background="{DynamicResource B.HeroFade}"/>
        </Grid>

        <!-- 书籍信息 -->
        <Grid Margin="32,6,32,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border CornerRadius="12" Effect="{StaticResource E.Shadow}" VerticalAlignment="Top">
                <c:CoverImage x:Name="Cover" Width="150" Height="200" Radius="12" Url="{Binding Record.CoverUrl}" SourceId="{Binding Record.SourceId}"
                              Title="{Binding Record.Title}"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="26,4,0,0">
                <TextBlock Text="{Binding Record.Title}" Style="{StaticResource T.Display}" FontSize="24" TextWrapping="Wrap" MaxHeight="66"/>
                <TextBlock Text="{Binding Meta}" Style="{StaticResource T.Secondary}" Margin="0,8,0,0" Visibility="{Binding Meta, Converter={StaticResource EmptyToCollapsed}}"/>
                <WrapPanel Margin="0,10,0,0">
                    <Border Style="{StaticResource Badge.Accent}" Margin="0,0,6,4">
                        <TextBlock Text="{Binding SourceName}" FontSize="11.5" Foreground="{DynamicResource B.Accent}"/>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Visibility="{Binding Record.Status, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock Text="{Binding Record.Status}" FontSize="11.5" Foreground="{DynamicResource B.Text2}"/>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,6,4" Visibility="{Binding EpisodeCount, Converter={StaticResource EmptyToCollapsed}}">
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource B.Text2}">共 <Run Text="{Binding EpisodeCount, Mode=OneWay}"/> 集</TextBlock>
                    </Border>
                </WrapPanel>

                <!-- 简介 -->
                <Grid Margin="0,8,0,0" MaxWidth="820" HorizontalAlignment="Left" Visibility="{Binding Record.Intro, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock x:Name="Intro" Text="{Binding Record.Intro}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" LineHeight="20"
                               MaxHeight="40" TextTrimming="CharacterEllipsis" Cursor="Hand" ToolTip="点击展开 / 收起" MouseLeftButtonUp="Intro_Click"/>
                </Grid>

                <!-- 操作 -->
                <WrapPanel Margin="0,14,0,0">
                    <Button Style="{StaticResource Btn.Primary}" Padding="20,8" Margin="0,0,10,8" Command="{Binding PlayOrResumeCommand}" c:Ui.CornerRadius="18">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource F.Icons}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PlayButtonText}"/>
                        </StackPanel>
                    </Button>
                    <Button Padding="16,8" Margin="0,0,10,8" Command="{Binding ToggleFavoriteCommand}" c:Ui.CornerRadius="18">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Secondary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Record.IsFavorite}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource B.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource F.Icons}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Text="{Binding Record.IsFavorite, Converter={StaticResource HeartGlyph}}"/>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="加入书架"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Record.IsFavorite}" Value="True">
                                                <Setter Property="Text" Value="已在书架"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Icon}" Content="&#xE8CB;" Margin="0,0,4,8" ToolTip="章节倒序" Command="{Binding ToggleReverseCommand}"/>
                    <Button Style="{StaticResource Btn.Icon}" Content="&#xE721;" Margin="0,0,4,8" ToolTip="在其它源中搜索这本书" Command="{Binding SearchOtherSourcesCommand}"/>                    <ToggleButton x:Name="SettingsToggle" Style="{StaticResource Toggle.Icon}" Content="&#xE713;" Margin="0,0,4,8" ToolTip="跳过片头片尾"/>
                    <Popup IsOpen="{Binding IsChecked, ElementName=SettingsToggle}" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Closed="SettingsPopup_Closed">
                        <Border Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1" CornerRadius="12"
                                Padding="16" Margin="8,4,8,16" Effect="{StaticResource E.Shadow}" Width="260">
                            <StackPanel>
                                <TextBlock Text="本书播放设置" Style="{StaticResource T.Subtitle}" Margin="0,0,0,12"/>
                                <DockPanel Margin="0,0,0,10">
                                    <TextBlock DockPanel.Dock="Right" Text="秒" Style="{StaticResource T.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding Record.SkipIntro, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="跳过片头" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="秒" Style="{StaticResource T.Secondary}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding Record.SkipOutro, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="跳过片尾" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Popup>
                </WrapPanel>
                <TextBlock Text="{Binding ResumeHint}" Style="{StaticResource T.Caption}" Visibility="{Binding ResumeHint, Converter={StaticResource EmptyToCollapsed}}"/>
            </StackPanel>
        </Grid>

        <!-- 章节 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,0,32,24" Padding="12,12,6,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="8,0,8,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE81D;" ToolTip="定位到正在播放" Click="Locate_Click" Margin="6,0,0,0"/>
                    <TextBox DockPanel.Dock="Right" Width="200" MinHeight="32" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                             c:Ui.Icon="&#xE71C;" c:Ui.Placeholder="筛选章节"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="选集" Style="{StaticResource T.Subtitle}"/>
                        <c:Spinner Width="16" Height="16" Margin="12,0,6,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding LoadingInfo}" Style="{StaticResource T.Caption}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource T.Caption}" Foreground="{DynamicResource B.Danger}" VerticalAlignment="Center"
                                   Margin="12,0,0,0" ToolTip="{Binding Error}" Visibility="{Binding ShowErrorOverlay, Converter={StaticResource BoolToVisInv}}"/>
                    </StackPanel>
                </DockPanel>

                <ListBox x:Name="EpisodeList" Grid.Row="1" ItemsSource="{Binding Episodes}" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource Row}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" CanContentScroll="True">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type sdk:Episode}">
                            <Grid Height="42" Background="Transparent">
                                <Grid.InputBindings>
                                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.PlayEpisodeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}"/>
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="playing" Text="&#xE768;" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{DynamicResource B.Accent}"
                                           VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="title" Grid.Column="1" Text="{Binding Title}" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="&#xE72E;" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{DynamicResource B.Text3}"
                                           VerticalAlignment="Center" ToolTip="付费章节" Visibility="{Binding IsFree, Converter={StaticResource BoolToVisInv}}"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource MultiEquals}">
                                            <Binding Path="Url"/>
                                            <Binding Path="DataContext.Player.CurrentEpisode.Url" RelativeSource="{RelativeSource AncestorType=UserControl}" FallbackValue="{x:Null}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="playing" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="title" Property="Foreground" Value="{DynamicResource B.Accent}"/>
                                    <Setter TargetName="title" Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFree}" Value="False">
                                    <Setter TargetName="title" Property="Opacity" Value="0.6"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowErrorOverlay, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Error}" Style="{StaticResource T.Secondary}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460"/>
                    <Button Style="{StaticResource Btn.Secondary}" Content="重试" HorizontalAlignment="Center" Margin="0,12,0,0" Command="{Binding LoadCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
