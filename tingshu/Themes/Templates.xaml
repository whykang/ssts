<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:tingshu.Controls"
                    xmlns:vm="clr-namespace:tingshu.ViewModels"
                    xmlns:core="clr-namespace:tingshu.Core">

    <!-- 可点击卡片外壳 -->
    <Style x:Key="ClickCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource B.BorderStrong}"/>
                <Setter Property="Effect" Value="{StaticResource E.Shadow}"/>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-2" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.15"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 横向书籍卡片（发现 / 搜索） -->
    <DataTemplate x:Key="BookCard" DataType="{x:Type vm:BookItem}">
        <Border Style="{StaticResource ClickCard}" ToolTip="{Binding Book.Title}">
            <Border.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding OpenBookCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}"/>
            </Border.InputBindings>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <c:CoverImage Width="78" Height="104" Radius="8" VerticalAlignment="Top"
                              Url="{Binding Book.CoverUrl}" SourceId="{Binding Book.SourceId}" Title="{Binding Book.Title}"/>
                <DockPanel Grid.Column="1" Margin="14,1,0,0" LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Book.Title}" Style="{StaticResource T.Body}" FontWeight="SemiBold" FontSize="14"
                               TextWrapping="Wrap" MaxHeight="40" LineHeight="20"/>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Meta}" Style="{StaticResource T.Caption}" Margin="0,4,0,0"
                               Visibility="{Binding Meta, Converter={StaticResource EmptyToCollapsed}}"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <Border Style="{StaticResource Badge.Accent}" Margin="0,0,6,0" Visibility="{Binding SourceName, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="{Binding SourceName}" FontSize="11" Foreground="{DynamicResource B.Accent}"/>
                        </Border>
                        <Border Style="{StaticResource Badge}" Visibility="{Binding Book.Status, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="{Binding Book.Status}" FontSize="11" Foreground="{DynamicResource B.Text2}" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Book.Intro}" Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               MaxHeight="34" LineHeight="17" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- 竖向封面卡片（书架） -->
    <DataTemplate x:Key="RecordCard" DataType="{x:Type core:BookRecord}">
        <Grid x:Name="root" Background="Transparent" Cursor="Hand" ToolTip="{Binding Title}">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding OpenBookCommand, Source={x:Static vm:MainViewModel.Instance}}" CommandParameter="{Binding}"/>
            </Grid.InputBindings>
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="继续播放" Command="{Binding PlacementTarget.Tag.ResumeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                    <MenuItem Header="加入书架 / 移出书架" Command="{Binding PlacementTarget.Tag.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="从列表中移除" Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                </ContextMenu>
            </Grid.ContextMenu>
            <Grid.Tag>
                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
            </Grid.Tag>
            <StackPanel>
                <Grid>
                    <Border CornerRadius="10" Effect="{StaticResource E.ShadowSmall}" Background="{DynamicResource B.Surface}">
                        <c:CoverImage x:Name="cover" Radius="10" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={x:Static c:AspectConverter.Portrait}}"
                                      Url="{Binding CoverUrl}" SourceId="{Binding SourceId}" Title="{Binding Title}"/>
                    </Border>
                    <!-- 悬停播放按钮 -->
                    <Button x:Name="play" Style="{StaticResource Btn.Play}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                            Opacity="0" Content="&#xE768;" ToolTip="继续播放"
                            Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                </Grid>
                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Body}" FontWeight="SemiBold" Margin="2,10,2,0"/>
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource T.Caption}" Margin="2,3,2,0"/>
                <TextBlock Text="{Binding SourceName}" Style="{StaticResource T.Caption}" Margin="2,1,2,0" FontSize="11"/>
            </StackPanel>
        </Grid>
        <DataTemplate.Triggers>
            <Trigger SourceName="root" Property="IsMouseOver" Value="True">
                <Setter TargetName="play" Property="Opacity" Value="1"/>
            </Trigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 空状态 -->
    <Style x:Key="EmptyState" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,60"/>
    </Style>

</ResourceDictionary>
