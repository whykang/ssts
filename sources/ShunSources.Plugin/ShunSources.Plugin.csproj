<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ShunSources.Plugin</AssemblyName>
    <RootNamespace>ShunSources</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>2.0.0</Version>
    <Company>shun（移植）</Company>
    <Description>听书源合集：全部听书源打包在这一个插件里（懒人听书、哔哩哔哩、酷我、评书随身听、相声随身听等 18 个源），导入即可使用</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\TingShu.Sdk\TingShu.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- 未验证 / 网站已失效的源：保留源码，不参与编译 -->
  <ItemGroup>
    <Compile Remove="Unverified\**" />
    <None Include="Unverified\**" />
  </ItemGroup>

</Project>
